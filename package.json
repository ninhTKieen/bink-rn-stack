{
  "name": "bink-rn-stack",
  "version": "0.1.3",
  "description": "Set up an opinionated stack for React Native and Expo applications.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ninhTKieen/bink-rn-stack.git"
  },
  "bugs": {
    "url": "https://github.com/ninhTKieen/bink-rn-stack/issues"
  },
  "homepage": "https://github.com/ninhTKieen/bink-rn-stack#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "bink-rn-stack": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "yarn clean && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "clean": "node --input-type=module --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "dev": "tsx src/cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "validate": "yarn format:check && yarn lint && yarn typecheck && yarn test && yarn build"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "andrew ninh",
  "license": "MIT",
  "dependencies": {
    "@babel/generator": "^7.29.8",
    "@babel/parser": "^7.29.8",
    "@babel/traverse": "^7.29.8",
    "@babel/types": "^7.29.8",
    "@inquirer/prompts": "^7.10.1",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^26.1.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "prettier": "^3.9.6",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
